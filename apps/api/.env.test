# Used by the e2e tests only, and the only env they read: apps/api/.env is
# ignored when NODE_ENV=test, so every required key must be here. A throwaway
# database in the docker compose Postgres, with its public local credentials,
# and fake secrets, so this file is committed.
# The name must end in _test: the e2e setup refuses anything else.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/starter_test"
JWT_SECRET="test-only-jwt-secret-not-for-real-use-0123456789"
