{
  "name": "@starter/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --enable-source-maps dist/main",
    "lint": "oxlint --type-aware --deny-warnings -c ../../.oxlintrc.json src/ test/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "postinstall": "prisma generate --no-hints",
    "db:generate": "prisma generate --no-hints",
    "db:migrate": "prisma migrate dev && prisma generate --no-hints",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:test:prepare": "node test/test-db.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@starter/shared": "workspace:*",
    "dotenv": "18.0.6",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "nestjs-pino": "5.3.0",
    "nestjs-zod": "5.5.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.2",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
