DATABASE_URL="postgresql://postgres:postgres@localhost:5432/starter"
NODE_ENV=development
PORT=8000
# fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=info
# Serve OpenAPI docs at /docs (default: true, false when NODE_ENV=production)
# SWAGGER_ENABLED=true
# Basic auth on the docs. Set both or neither; both are required when
# SWAGGER_ENABLED=true and NODE_ENV=production.
# SWAGGER_USER=docs
# SWAGGER_PASSWORD=change-me
# Comma-separated browser origins allowed by CORS, e.g. https://app.example.com
# (default: http://localhost:5173, required when NODE_ENV=production)
# CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (e.g. 1 behind a single load
# balancer). Unset: X-Forwarded-For is ignored and the socket address is used.
# TRUST_PROXY=1
# Signing key for access tokens. Required, at least 32 characters. Generate one:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Access token lifetime in seconds (default: 900, 15 minutes)
# AUTH_ACCESS_TTL=900
# Refresh session lifetime in seconds, renewed on every refresh (default:
# 604800, 7 days)
# AUTH_REFRESH_TTL=604800
# Seconds a just-replaced refresh token is still accepted, for concurrent
# refreshes from one browser (default: 30)
# AUTH_REFRESH_GRACE=30
# Name of the refresh token cookie (default: refresh_token)
# AUTH_COOKIE_NAME=refresh_token
# Cookie Domain attribute. Unset (default): the cookie is sent to this host only.
# AUTH_COOKIE_DOMAIN=example.com
# First admin, created by `pnpm --filter @starter/api db:seed` if that email
# does not exist yet. Only the seed reads these.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me
# SEED_ADMIN_NAME=Admin
